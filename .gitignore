# environments
.venv/
.superpowers/
.omg/

# benchmark data (cloned by hash; reproduce with `git clone`, don't commit)
data/

# caches -- rebuildable from cache/llm/*.json only if you keep them;
# by default these are large and regenerable
cache/
graphs/embeddings/

# results are small and SHOULD be committed so numbers are auditable
# results/   <- intentionally NOT ignored

# ...but the colab working logs are refreshed on every pull and churn the tree;
# the metrics they echo live in results/*.json, which ARE committed
results/*.log

# python
__pycache__/
*.pyc
*.egg-info/
src/*.egg-info/

# secrets -- never commit
.env
*.key
