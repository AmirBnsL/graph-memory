# Copy to `.env` and fill in. `.env` is gitignored -- never commit a real key.
#
# Groq (free tier, fast):  https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=gsk_your_key_here

# --- alternatives (change LLM_PROVIDER + LLM_MODEL) ---
# Google Gemini free tier:
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.0-flash
#   LLM_API_KEY=your_google_ai_studio_key
#
# Local Ollama (no key; install ollama, then `ollama pull qwen2.5:7b-instruct`):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b-instruct
